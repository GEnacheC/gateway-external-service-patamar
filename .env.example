# Copy to .env and fill values as needed

# Sympla official API (organizer-owned events only)
# Generate at: Sympla > Minha Conta > Integrações
SYMPLA_TOKEN=

# Ticketmaster Discovery API (optional)
# https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=

# Curitiba PMC geocoding (Nominatim). Keep lower for faster sync.
CURITIBA_PMC_GEOCODING=true
CURITIBA_PMC_GEOCODE_MAX=40

# Radar (city-sized cache)
RADAR_CITY_RADIUS_KM=25
RADAR_SYNC_TTL_HOURS=6
